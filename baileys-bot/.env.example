# ==============================================================================
# DCMS BAILEYS REACTION BOT - ENVIRONMENT CONFIGURATION (RENDER.COM / VPS)
# ==============================================================================

# Port Web Server (Render.com akan mengisi otomatis variable PORT ini)
PORT=3000

# Endpoint Webhook DCMS (Ganti dengan domain cPanel atau Cloudflare Tunnel DCMS Anda)
# Contoh cPanel: https://dcms-sosmed.my.id/api/fonnte-webhook
# Contoh Localhost Tunnel: https://your-tunnel.trycloudflare.com/api/fonnte-webhook
DCMS_WEBHOOK_URL=https://dcms-sosmed.my.id/api/fonnte-webhook

# Kunci API Opsional untuk verifikasi header X-API-Key (jika diaktifkan di DCMS)
DCMS_API_KEY=dcms2026

# Filter Grup WhatsApp Target (Kosongkan jika ingin mendengarkan semua grup WhatsApp)
# Pisahkan dengan koma jika lebih dari satu grup ID: 120363041234567890@g.us,120363098765432100@g.us
TARGET_GROUPS=

# Keep-Alive Self-Ping di Render (Opsional: Render Free Tier sleep setelah 15 menit jika tanpa traffic)
# Render otomatis menyediakan variabel RENDER_EXTERNAL_URL pada dashboard
RENDER_EXTERNAL_URL=

# Nomor default untuk Pairing Code (Opsional, format internasional: 628123456789)
PAIRING_PHONE=
